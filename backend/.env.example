# Copy this file to .env and fill in real values. Never commit the real .env.

# MongoDB Atlas connection string -- both detections and chat conversations live in MongoDB.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_DB_NAME=pothole_detection

# Cloudinary (optional) -- if set, uploaded/annotated images are stored there instead of on
# local disk. Find these on your Cloudinary dashboard under Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=REPLACE_ME

# Check https://console.groq.com/docs/models for the current list of active models
GROQ_MODEL=openai/gpt-oss-120b

# Optional: a smaller/faster model for query classification (see app/query_classifier.py).
# Leave blank to reuse GROQ_MODEL.
GROQ_CLASSIFIER_MODEL=

# JSON list of allowed frontend origins for CORS
CORS_ORIGINS=["http://localhost:5173"]
